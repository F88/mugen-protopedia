# Environment configuration
#
# Usage
# 1. Copy this file to .env.local (ignored by git)
# 2. Adjust values as needed for your environment
# 3. Restart the dev server after changes
#
# Notes
# - Next.js loads env files in this order of priority:
#   .env.local, .env.development/local, .env, etc.
# - Do NOT commit .env.local to version control.
# - NODE_ENV is managed by Next.js/your process manager; you usually do not set it here.
#
# ------------------------------
# Server logging (pino)
# ------------------------------
# Log verbosity. Typical values: debug | info | warn | error
# Optional. Default: debug (development) / info (production)
LOG_LEVEL=error
#LOG_LEVEL=debug

# Pretty-print logs for local readability using pino-pretty.
# Accepted values: 1/true to enable, 0/false to disable
# Optional. Default: enabled in development, disabled otherwise
LOG_PRETTY=1

# ------------------------------
# Client logging (browser console)
# ------------------------------
# Client-side log verbosity. Typical values: debug | info | warn | error | silent
# Optional. Default: info (development) / warn (production)
# Note: Must use NEXT_PUBLIC_ prefix to expose to browser
NEXT_PUBLIC_CLIENT_LOG_LEVEL=info
#NEXT_PUBLIC_CLIENT_LOG_LEVEL=debug

# ------------------------------
# ProtoPedia API client
# ------------------------------
# Access token for ProtoPedia API v2.
# Required to fetch real data. No default.
# If unset or placeholder, a dummy token is sent, so builds and tests still run.
PROTOPEDIA_API_V2_TOKEN=your_token_here

# Override API base URL.
# Optional. Default: https://protopedia.net/v2/api
# In tests we point to an MSW-handled origin.
#PROTOPEDIA_API_V2_BASE_URL=https://protopedia.net/v2/api

# Client library log level: silent | error | warn | info | debug
# Optional. Default: error
PROTOPEDIA_API_V2_LOG_LEVEL=error
#PROTOPEDIA_API_V2_LOG_LEVEL=debug

# Limit for a whole API request in milliseconds, including the response body.
# Raise it on a slow development connection. Must be a positive integer.
# Optional. Default: 30000
#PROTOPEDIA_API_V2_TIMEOUT_MS=30000

# ------------------------------
# Prototype fetch tuning
# ------------------------------
# Page size used when fetching candidate prototypes
# Optional. Default: 100
PROTOTYPE_PAGE_LIMIT=100

# ------------------------------
# Promidas repository (in-memory snapshot)
# ------------------------------
# Master opt-in switch for the promidas repository migration (#181).
# When enabled, consumers read prototypes via the promidas in-memory
# Repository instead of the legacy map-store path.
# Set to the exact string `true` to enable; anything else (or unset) disables.
# Optional. Default: disabled (legacy map-store).
#USE_PROMIDAS_REPOSITORY=true

# In-process snapshot TTL in seconds.
# Optional. Default: 600 (10 minutes)
#PROMIDAS_STORE_TTL_SECONDS=600

# ------------------------------
# Tests and opt-in live checks
# ------------------------------
# Run the live API test only when set to 1 and a real token is provided
# Optional. Default: disabled
RUN_LIVE_API_TESTS=0

# ------------------------------
# SEO / Site verification
# ------------------------------
# Google Search Console site verification token
# Copy your token from the Search Console property settings
# and set it here in your .env.local (do not commit secrets).
# Optional. No default: if unset, the verification meta will be omitted.
GOOGLE_SITE_VERIFICATION_TOKEN=your_verification_string

# ------------------------------
# API Mocking (MSW)
# ------------------------------
# Enable Mock Service Worker in development mode to use local snapshots
# instead of hitting the real ProtoPedia API.
# Values: enabled | disabled
# Optional. Default: disabled
NEXT_PUBLIC_API_MOCKING=disabled
